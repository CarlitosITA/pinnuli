# Copiare in /opt/pinnuli/.env e compilare. Non va mai nel repository.

# Password del database dedicato (generarne una lunga: openssl rand -hex 24)
POSTGRES_PASSWORD=

# Chiave per le sessioni, almeno 32 caratteri (openssl rand -hex 32)
SESSION_SECRET=

# Indirizzo pubblico dell'app, con https
APP_URL=https://app.pinnuli.it

# Porta locale per il reverse proxy: verificare che sia libera con `ss -tlnp`
PINNULI_PORT=38100

# Telegram (facoltativo, ma è il canale principale degli avvisi ai familiari)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# Notifiche sul telefono (Web Push). Si generano una volta sola con:  npx web-push generate-vapid-keys
# Senza queste chiavi il promemoria resta solo sullo schermo del dispositivo aperto. La chiave privata non va condivisa.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:giovanni.parato@gmail.com

# Se si usano immagini già costruite da GitHub Container Registry
# PINNULI_WEB_IMAGE=ghcr.io/carlitosita/pinnuli-web:latest
# PINNULI_WORKER_IMAGE=ghcr.io/carlitosita/pinnuli-worker:latest
