# Copiare in .env.local (sviluppo) o nel file .env di deploy/
DATABASE_URL=postgres://pinnuli:pinnuli@localhost:5432/pinnuli
# Chiave per firmare i cookie di sessione dei familiari (almeno 32 caratteri casuali)
SESSION_SECRET=cambia-questa-chiave-con-32-caratteri-casuali
# Primo familiare (creato da `npm run db:seed`)
ADMIN_EMAIL=giovanni@example.com
ADMIN_NAME=Giovanni
ADMIN_PASSWORD=cambia-questa-password
PATIENT_NAME=Mamma
# Telegram (facoltativo): token del bot e segreto del webhook
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_USERNAME=
# Indirizzo pubblico dell'app
APP_URL=http://localhost:3000
